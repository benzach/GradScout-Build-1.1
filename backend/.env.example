# Local Postgres by default. In production this is Railway's own
# Postgres plugin, wired in automatically — you won't set this by hand
# there (see README.md's Deploying section).
DATABASE_URL=postgresql://gradscout:localdev@localhost/gradscout_dev

# Signs and verifies every access token this API issues (see
# app/security.py). Generate a real one with: openssl rand -hex 32
# Treat this like a password — anyone with it can forge a valid login
# for any user.
JWT_SECRET_KEY=

# Public API keys for the three registered scraper sources. Free-tier
# signups: Adzuna (developer.adzuna.com), Reed (reed.co.uk/developers),
# Jooble (jooble.org/api/about). Without these, those three sources
# fail every scrape cycle — CharityJob/ACCA/ThirdSector/w4mpjobs don't
# need keys and keep working regardless.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
JOOBLE_API_KEY=

# How often the background scheduler re-scrapes every source, in
# minutes. Optional — defaults to 20 if unset.
SCRAPE_INTERVAL_MINUTES=20

# Set to "true" to disable the background scheduler entirely (used by
# the test suite, and useful for local API poking without triggering
# real scrapes on every restart). Leave unset in deployment.
DISABLE_SCHEDULER=
