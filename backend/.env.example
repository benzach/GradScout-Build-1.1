# Local Postgres by default. In production this is Railway's own
# Postgres plugin, wired in automatically — you won't set this by hand
# there (see README.md's Deploying section).
DATABASE_URL=postgresql://gradscout:localdev@localhost/gradscout_dev

# Signs and verifies every access token this API issues (see
# app/security.py). Generate a real one with: openssl rand -hex 32
# Treat this like a password — anyone with it can forge a valid login
# for any user.
JWT_SECRET_KEY=

# Public API keys for the three registered scraper sources. Free-tier
# signups: Adzuna (developer.adzuna.com), Reed (reed.co.uk/developers),
# Jooble (jooble.org/api/about). Without these, those three sources
# fail every scrape cycle — CharityJob/ACCA/ThirdSector/w4mpjobs don't
# need keys and keep working regardless.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
JOOBLE_API_KEY=

# Optional. Enables a second-pass AI classification fallback (see
# app/ai_classification.py) for the jobs the free rule-based location/
# industry taxonomy can't confidently place — i.e. only the ones that
# would otherwise land in "Other UK" / "Other". Get a key at
# console.anthropic.com. Leave unset and the app works exactly as
# before, just without this extra pass — it's a genuine enhancement,
# not a dependency.
ANTHROPIC_API_KEY=

# Identifies GradScout's scrapers honestly to sites without an official
# API (currently CharityJob/ACCA/ThirdSector — see
# app/scrapers/http_headers.py, and note those three are paused as of
# migrations/0010_pause_unofficial_static_sources.sql). Sent as part of
# the User-Agent header. Optional, but should point to something real
# once GradScout has a public presence — a bare identifier without a
# way to reach you is honest but not very useful to a site owner who
# wants to get in touch.
SCRAPER_CONTACT_URL=
SCRAPER_CONTACT_EMAIL=

# How often the background scheduler re-scrapes every source, in
# minutes. Optional — defaults to 20 if unset.
SCRAPE_INTERVAL_MINUTES=20

# How many days a job can go without being re-confirmed present on any
# of its sources before it's marked expired (see
# app/storage.py's sweep_expired_jobs()). Optional — defaults to 3 if
# unset.
JOB_EXPIRY_STALE_DAYS=3

# Weekly email digest (see app/email_digest.py) — a fallback/complement
# to push notifications for people who haven't installed the PWA.
# Optional as a whole: leave RESEND_API_KEY unset and the digest job
# runs on schedule but does nothing, same no-op pattern as every other
# optional integration in this file. Get a key at resend.com — the
# free tier is generous enough for a closed test's user count.
RESEND_API_KEY=
# Must be an address on a domain you've verified with Resend (their
# dashboard walks through the DNS records) — unverified "from"
# addresses get rejected or land in spam.
DIGEST_FROM_EMAIL=
# Used to build real links in the digest email (job detail pages,
# Settings) — e.g. https://gradscout.app. Leave unset and links fall
# back to "#", which the email still sends fine, just without
# clickable links - fine for testing the email itself, not for a real
# send.
FRONTEND_BASE_URL=
# How far back to look for a user's first-ever digest (someone with no
# last_digest_sent_at yet). Optional — defaults to 7 if unset.
DIGEST_LOOKBACK_DAYS=7
# When the weekly digest sends, UTC, cron-style. Optional — defaults to
# Monday 08:00 UTC if unset.
DIGEST_DAY_OF_WEEK=mon
DIGEST_HOUR_UTC=8

# Set to "true" to disable the background scheduler entirely (used by
# the test suite, and useful for local API poking without triggering
# real scrapes on every restart). Leave unset in deployment.
DISABLE_SCHEDULER=
