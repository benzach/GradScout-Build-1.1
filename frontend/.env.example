# Where the FastAPI backend lives. Point this at your local backend
# (uvicorn's default) for development, and at your deployed Railway URL
# for a production build.
VITE_API_BASE_URL=http://localhost:8000

# Optional, privacy-friendly usage analytics via Plausible (see
# src/lib/analytics.js). Leave unset and nothing loads, nothing is
# sent — no account, no domain to track yet.
VITE_PLAUSIBLE_DOMAIN=
# Only needed for a self-hosted Plausible instance — leave unset to
# use Plausible's own cloud service.
VITE_PLAUSIBLE_SCRIPT_SRC=
